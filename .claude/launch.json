{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nazar",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 3300
    },
    {
      "name": "nazar-elections",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "env": { "ELECTION_WORKER": "on" },
      "port": 3300
    },
    {
      "name": "nazar-view",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "env": { "ELECTION_WORKER": "off" },
      "port": 3300
    }
  ]
}
